# Append blocks like these to ~/.gitconfig — one per project folder (or
# per parent folder if several repos belong to the same account).
# Trailing slash on the gitdir path is required.

[includeIf "gitdir:~/Developer/claude-session-monitor/"]
	path = ~/.gitconfig-achint-gupta-tech

# Example for another project under a different account — copy, rename
# the path, and fill in the matching ~/.gitconfig-<account> file:
#
# [includeIf "gitdir:~/Developer/corriente-apps/"]
# 	path = ~/.gitconfig-corriente-app
#
# [includeIf "gitdir:~/Developer/some-other-client-project/"]
# 	path = ~/.gitconfig-ruvofin-solutions
